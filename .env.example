# Finders settings. Copy to .env and fill in. Never commit .env.
# PayPal sandbox REST app (developer.paypal.com -> Apps & Credentials -> Sandbox). Finders refuses non-sandbox hosts.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Gemini API key (aistudio.google.com). Without it Finders falls back to simple keyword rules (labelled in the UI).
GEMINI_API_KEY=
# Operator console access. A long random string; or FINDERS_OPEN_CONSOLE=1 for local development only.
FINDERS_OPERATOR_KEY=
# Optional
FINDERS_DB=finders.db
PORT=8078
HOST=127.0.0.1
# Only for scripts/live_case.py: a sandbox Personal account that receives the finder's reward
PAYPAL_SANDBOX_BUYER_EMAIL=
